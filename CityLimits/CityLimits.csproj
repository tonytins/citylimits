<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <!-- A backport's version is GitInfo.txt's, such as 0.3.100.1: the release it backports and a
         revision, which GitInfo reads as its label. Its commits aren't counted into the patch, which
         would run into the next release, and tags and branch names, such as release/0.3.100, are
         ignored, since GitInfo would otherwise take them ahead of the file. -->
    <GitIgnoreTagVersion>true</GitIgnoreTagVersion>
    <GitIgnoreBranchVersion>true</GitIgnoreBranchVersion>
    <GitBaseVersionRegex>^(?&lt;MAJOR&gt;\d+)\.(?&lt;MINOR&gt;\d+)\.(?&lt;PATCH&gt;\d+)\.(?&lt;LABEL&gt;\d+)$</GitBaseVersionRegex>
    <GitVersion>false</GitVersion>
  </PropertyGroup>

  <!-- GitInfo's own version would carry the counted patch, so the backport sets its four parts itself. -->
  <Target Name="SetBackportVersion" DependsOnTargets="GitVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <PropertyGroup>
      <Version>$(GitBaseVersionMajor).$(GitBaseVersionMinor).$(GitBaseVersionPatch).$(GitSemVerLabel)</Version>
      <AssemblyVersion>$(Version)</AssemblyVersion>
      <FileVersion>$(Version)</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="GitInfo" Version="3.6.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CityLimits.Core\CityLimits.Core.csproj" />
    <ProjectReference Include="..\CityLimits.CommandLine\CityLimits.CommandLine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\README.md" />
    <None Update="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
