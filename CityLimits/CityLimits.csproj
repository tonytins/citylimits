<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <!-- A backport is frozen at its own version: GitInfo would count its commits into the patch and
         collide with the next real release, so it keeps only the commit for the build number. -->
    <GitVersion>false</GitVersion>
    <Version>0.3.100.1</Version>
    <AssemblyVersion>0.3.100.1</AssemblyVersion>
    <FileVersion>0.3.100.1</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitInfo" Version="3.6.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CityLimits.Core\CityLimits.Core.csproj" />
    <ProjectReference Include="..\CityLimits.CommandLine\CityLimits.CommandLine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\README.md" />
    <None Update="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
