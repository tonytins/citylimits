{
  "$schema": "https://raw.githubusercontent.com/tonytins/citylimits/main/docs/schemas/scenario.v2.0.schema.json",
  "format": "2.0",
  "name": "Zones and the bulldozer",
  "description": "A grid of zones along a road, powered by a coal plant beside them, a zone with no road or power, and the bulldozer's rules for zones.",
  "seed": 2000,
  "ends": "1901-01",
  "actions": [
    { "at": "1900-01", "tool": "Road", "from": { "x": 34, "y": 54 }, "to": { "x": 45, "y": 54 }, "expect": "Built" },
    { "at": "1900-01", "tool": "ZoneResidential", "from": { "x": 35, "y": 52 }, "to": { "x": 41, "y": 52 }, "expect": "Built" },
    { "at": "1900-01", "tool": "ZoneCommercial", "from": { "x": 44, "y": 48 }, "expect": "Built" },
    { "at": "1900-01", "tool": "CoalPowerPlant", "from": { "x": 36, "y": 41 }, "expect": "Built" },
    { "at": "1900-01", "tool": "PowerLine", "from": { "x": 36, "y": 44 }, "to": { "x": 36, "y": 50 }, "expect": "Built" },
    { "at": "1900-01", "tool": "ZoneIndustrial", "from": { "x": 36, "y": 52 }, "expect": "Refused:CannotBuildHere" },
    { "at": "1900-01", "tool": "Bulldoze", "from": { "x": 34, "y": 51 }, "expect": "Refused:PartOfAZone" },
    { "at": "1900-01", "tool": "Bulldoze", "from": { "x": 34, "y": 48 }, "expect": "Unchanged:NothingToClear" },
    { "at": "1901-01", "tool": "Bulldoze", "from": { "x": 37, "y": 52 }, "to": { "x": 39, "y": 52 }, "expect": "Built" }
