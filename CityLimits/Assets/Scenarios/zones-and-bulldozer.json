    { "at": "1900-01", "tile": { "x": 35, "y": 52 }, "served": true },
    { "at": "1900-01", "tile": { "x": 44, "y": 48 }, "served": false },
    { "at": "1900-12", "week": 4, "count": "Developed", "atLeast": 1 },
    { "at": "1900-12", "week": 4, "tile": { "x": 44, "y": 48 }, "development": 0, "powered": false },
    { "at": "1900-12", "week": 4, "tile": { "x": 41, "y": 52 }, "powered": true },
    { "at": "1901-01", "tile": { "x": 38, "y": 52 }, "kind": "Rubble", "use": "None" },
    { "at": "1901-01", "count": "Residential", "equals": 2 },
    { "at": "1901-01", "fundsEquals": 16444 }
