{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tonytins/citylimits/main/docs/schemas/mod.v1.0.schema.json",
  "title": "A CityLimits mod's mod.json: who the mod is",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The schema the file follows, for editors; the game ignores it.",
      "type": "string"
    },
    "format": {
      "description": "The file's format version, as \"major.minor\"; a whole number, as older files wrote it, is that major version, .0.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
