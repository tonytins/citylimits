{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tonytins/citylimits/main/docs/schemas/facilities.v2.1.schema.json",
  "title": "A CityLimits spec file, facilities.json, in a mod or common/: the facilities",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The schema the file follows, for editors; the game ignores it.",
      "type": "string"
    },
    "format": {
      "description": "The file's format version, as \"major.minor\"; a whole number, as older files wrote it, is that major version, .0.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "integer"
          },
          "demandCap": {
            "type": "integer"
          },
          "pollution": {
            "type": "integer"
          },
          "influences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "effect": {
                  "type": "string"
                },
                "strength": {
                  "type": "integer"
                },
                "reach": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
