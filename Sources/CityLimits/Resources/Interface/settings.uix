<?xml version="1.0" encoding="UTF-8"?>
<!-- The settings, a modal window with a tab for the game and one for each disaster. Each setting
     is a row of buttons, the one in force held down; the line at the bottom says what the setting
     under the pointer does. Rows on the same tab share their places. -->
<UIScript version="1">
  <Window width="400" height="330"/>

  <ToolbarItem name="gameTab" title="Game"/>
  <ToolbarItem name="disastersTab" title="Disasters"/>

  <Style name="label" textColor="#E4E8EE" fontSize="14"/>
  <Style name="about" textColor="#969EAA" fontSize="10"/>
  <Style name="option" textColor="#969EAA" selectedTextColor="#F0BE5A" highlightedTextColor="#E4E8EE" backgroundColor="#161A20" borderColor="#48505C" fontSize="14"/>

  <Text name="fullscreenLabel" x="14" y="20" width="150" height="14" style="label" text="Fullscreen"/>
  <Button name="fullscreen0" x="170" y="14" width="68" height="26" style="option" text="Off"/>
  <Button name="fullscreen1" x="242" y="14" width="68" height="26" style="option" text="On"/>
  <Text name="autosaveLabel" x="14" y="52" width="150" height="14" style="label" text="Autosave"/>
  <Button name="autosave0" x="170" y="46" width="68" height="26" style="option" text="Off"/>
  <Button name="autosave1" x="242" y="46" width="68" height="26" style="option" text="One"/>
  <Button name="autosave2" x="314" y="46" width="68" height="26" style="option" text="Two"/>
  <Text name="disastersLabel" x="14" y="84" width="150" height="14" style="label" text="Disasters"/>
  <Button name="disasters0" x="170" y="78" width="68" height="26" style="option" text="Off"/>
  <Button name="disasters1" x="242" y="78" width="68" height="26" style="option" text="On"/>
  <Text name="firesLabel" x="14" y="20" width="150" height="14" style="label" text="Fires"/>
  <Button name="fires0" x="170" y="14" width="68" height="26" style="option" text="Off"/>
  <Button name="fires1" x="242" y="14" width="68" height="26" style="option" text="On"/>
  <Text name="floodsLabel" x="14" y="52" width="150" height="14" style="label" text="Floods"/>
  <Button name="floods0" x="170" y="46" width="68" height="26" style="option" text="Off"/>
  <Button name="floods1" x="242" y="46" width="68" height="26" style="option" text="On"/>
  <Text name="earthquakesLabel" x="14" y="84" width="150" height="14" style="label" text="Earthquakes"/>
  <Button name="earthquakes0" x="170" y="78" width="68" height="26" style="option" text="Off"/>
  <Button name="earthquakes1" x="242" y="78" width="68" height="26" style="option" text="On"/>
  <Text name="meltdownsLabel" x="14" y="116" width="150" height="14" style="label" text="Meltdowns"/>
  <Button name="meltdowns0" x="170" y="110" width="68" height="26" style="option" text="Off"/>
  <Button name="meltdowns1" x="242" y="110" width="68" height="26" style="option" text="On"/>
  <Text name="airCrashesLabel" x="14" y="148" width="150" height="14" style="label" text="Air crashes"/>
  <Button name="airCrashes0" x="170" y="142" width="68" height="26" style="option" text="Off"/>
  <Button name="airCrashes1" x="242" y="142" width="68" height="26" style="option" text="On"/>
  <Text name="shipwrecksLabel" x="14" y="180" width="150" height="14" style="label" text="Shipwrecks"/>
  <Button name="shipwrecks0" x="170" y="174" width="68" height="26" style="option" text="Off"/>
  <Button name="shipwrecks1" x="242" y="174" width="68" height="26" style="option" text="On"/>
  <Text name="tornadoesLabel" x="14" y="212" width="150" height="14" style="label" text="Tornadoes"/>
  <Button name="tornadoes0" x="170" y="206" width="68" height="26" style="option" text="Off"/>
  <Button name="tornadoes1" x="242" y="206" width="68" height="26" style="option" text="On"/>
  <Text name="monstersLabel" x="14" y="244" width="150" height="14" style="label" text="Monsters"/>
  <Button name="monsters0" x="170" y="238" width="68" height="26" style="option" text="Off"/>
  <Button name="monsters1" x="242" y="238" width="68" height="26" style="option" text="On"/>
  <Text name="about" x="14" y="276" width="372" height="40" style="about"/>
</UIScript>
