<?xml version="1.0" encoding="UTF-8"?>
<!-- A scenario's details, in a modal window over the city panel: its name, start, end, money, and
     briefing on the left; up to five goals and five disasters on the right. Nothing changes until
     Apply, which checks them as a file would. A row the scenario doesn't use is hidden. -->
<UIScript version="1">
  <Window width="780" height="470"/>

  <Style name="label" textColor="#969EAA" fontSize="10"/>
  <Style name="heading" textColor="#E4E8EE" fontSize="14"/>
  <Style name="set" textColor="#969EAA" fontSize="14"/>
  <Style name="problem" textColor="#E86A60" fontSize="10"/>
  <Style name="note" textColor="#969EAA" fontSize="10"/>
  <Style name="pick" textColor="#E4E8EE" highlightedTextColor="#F0BE5A" backgroundColor="#161A20" borderColor="#48505C" fontSize="12"/>
  <Style name="small" textColor="#F0BE5A" highlightedTextColor="#FFFFFF" backgroundColor="#00000000" borderColor="#00000000" fontSize="12"/>
  <Style name="remove" textColor="#969EAA" highlightedTextColor="#E86A60" backgroundColor="#00000000" borderColor="#00000000" fontSize="14"/>

  <Text name="nameLabel" x="14" y="10" width="236" height="10" style="label" text="Name"/>
  <TextField name="name" x="14" y="22" width="236" height="26" maximumLength="80"/>
  <Text name="startLabel" x="14" y="58" width="236" height="10" style="label" text="Starts in the year"/>
  <TextField name="start" x="14" y="70" width="110" height="26" maximumLength="4"/>
  <Text name="startSet" x="14" y="76" width="236" height="14" style="set"/>
  <Text name="endsLabel" x="14" y="106" width="236" height="10" style="label" text="Ends, judged in the month"/>
  <TextField name="ends" x="14" y="118" width="110" height="26" maximumLength="7"/>
  <Text name="fundsLabel" x="14" y="154" width="236" height="10" style="label" text="Funds to start with"/>
  <TextField name="funds" x="14" y="166" width="110" height="26" maximumLength="7"/>
  <Text name="fundsSet" x="14" y="172" width="236" height="14" style="set" text="Set by its city"/>
  <Text name="descriptionLabel" x="14" y="202" width="236" height="10" style="label" text="Description, the briefing"/>
  <TextArea name="description" x="14" y="214" width="236" height="170" maximumLength="500"/>

  <Text name="goalsHeading" x="266" y="10" width="200" height="14" style="heading" text="Goals"/>
  <Button name="addGoal" x="660" y="6" width="100" height="22" style="small" text="+ Add"/>
  <Text name="goalMeasureLabel" x="266" y="32" width="100" height="10" style="label" text="measure"/>
  <Text name="goalLeastLabel" x="372" y="32" width="80" height="10" style="label" text="at least"/>
  <Text name="goalMostLabel" x="458" y="32" width="80" height="10" style="label" text="at most"/>
  <Text name="goalTextLabel" x="544" y="32" width="200" height="10" style="label" text="its words: blank to word it from the measure"/>
  <Button name="goalMeasure0" x="266" y="44" width="100" height="24" style="pick"/>
  <TextField name="goalLeast0" x="372" y="44" width="80" height="24" maximumLength="11"/>
  <TextField name="goalMost0" x="458" y="44" width="80" height="24" maximumLength="11"/>
  <TextField name="goalText0" x="544" y="44" width="196" height="24" maximumLength="120"/>
  <Button name="goalRemove0" x="744" y="44" width="22" height="24" style="remove" text="x"/>
  <Button name="goalMeasure1" x="266" y="74" width="100" height="24" style="pick"/>
  <TextField name="goalLeast1" x="372" y="74" width="80" height="24" maximumLength="11"/>
  <TextField name="goalMost1" x="458" y="74" width="80" height="24" maximumLength="11"/>
  <TextField name="goalText1" x="544" y="74" width="196" height="24" maximumLength="120"/>
  <Button name="goalRemove1" x="744" y="74" width="22" height="24" style="remove" text="x"/>
  <Button name="goalMeasure2" x="266" y="104" width="100" height="24" style="pick"/>
  <TextField name="goalLeast2" x="372" y="104" width="80" height="24" maximumLength="11"/>
  <TextField name="goalMost2" x="458" y="104" width="80" height="24" maximumLength="11"/>
  <TextField name="goalText2" x="544" y="104" width="196" height="24" maximumLength="120"/>
  <Button name="goalRemove2" x="744" y="104" width="22" height="24" style="remove" text="x"/>
  <Button name="goalMeasure3" x="266" y="134" width="100" height="24" style="pick"/>
  <TextField name="goalLeast3" x="372" y="134" width="80" height="24" maximumLength="11"/>
  <TextField name="goalMost3" x="458" y="134" width="80" height="24" maximumLength="11"/>
  <TextField name="goalText3" x="544" y="134" width="196" height="24" maximumLength="120"/>
  <Button name="goalRemove3" x="744" y="134" width="22" height="24" style="remove" text="x"/>
  <Button name="goalMeasure4" x="266" y="164" width="100" height="24" style="pick"/>
  <TextField name="goalLeast4" x="372" y="164" width="80" height="24" maximumLength="11"/>
  <TextField name="goalMost4" x="458" y="164" width="80" height="24" maximumLength="11"/>
  <TextField name="goalText4" x="544" y="164" width="196" height="24" maximumLength="120"/>
  <Button name="goalRemove4" x="744" y="164" width="22" height="24" style="remove" text="x"/>
  <Text name="eventsHeading" x="266" y="206" width="200" height="14" style="heading" text="Disasters"/>
  <Button name="addEvent" x="660" y="202" width="100" height="22" style="small" text="+ Add"/>
  <Text name="eventAtLabel" x="266" y="228" width="80" height="10" style="label" text="in the month"/>
  <Text name="eventWeekLabel" x="350" y="228" width="40" height="10" style="label" text="week"/>
  <Text name="eventDisasterLabel" x="394" y="228" width="110" height="10" style="label" text="disaster"/>
  <Text name="eventEveryLabel" x="510" y="228" width="110" height="10" style="label" text="repeat every, weeks"/>
  <Text name="eventTimesLabel" x="626" y="228" width="80" height="10" style="label" text="times"/>
  <TextField name="eventAt0" x="266" y="240" width="80" height="24" maximumLength="7"/>
  <TextField name="eventWeek0" x="350" y="240" width="40" height="24" maximumLength="1"/>
  <Button name="eventDisaster0" x="394" y="240" width="110" height="24" style="pick"/>
  <TextField name="eventEvery0" x="510" y="240" width="110" height="24" maximumLength="4"/>
  <TextField name="eventTimes0" x="626" y="240" width="80" height="24" maximumLength="4"/>
  <Button name="eventRemove0" x="744" y="240" width="22" height="24" style="remove" text="x"/>
  <TextField name="eventAt1" x="266" y="270" width="80" height="24" maximumLength="7"/>
  <TextField name="eventWeek1" x="350" y="270" width="40" height="24" maximumLength="1"/>
  <Button name="eventDisaster1" x="394" y="270" width="110" height="24" style="pick"/>
  <TextField name="eventEvery1" x="510" y="270" width="110" height="24" maximumLength="4"/>
  <TextField name="eventTimes1" x="626" y="270" width="80" height="24" maximumLength="4"/>
  <Button name="eventRemove1" x="744" y="270" width="22" height="24" style="remove" text="x"/>
  <TextField name="eventAt2" x="266" y="300" width="80" height="24" maximumLength="7"/>
  <TextField name="eventWeek2" x="350" y="300" width="40" height="24" maximumLength="1"/>
  <Button name="eventDisaster2" x="394" y="300" width="110" height="24" style="pick"/>
  <TextField name="eventEvery2" x="510" y="300" width="110" height="24" maximumLength="4"/>
  <TextField name="eventTimes2" x="626" y="300" width="80" height="24" maximumLength="4"/>
  <Button name="eventRemove2" x="744" y="300" width="22" height="24" style="remove" text="x"/>
  <TextField name="eventAt3" x="266" y="330" width="80" height="24" maximumLength="7"/>
  <TextField name="eventWeek3" x="350" y="330" width="40" height="24" maximumLength="1"/>
  <Button name="eventDisaster3" x="394" y="330" width="110" height="24" style="pick"/>
  <TextField name="eventEvery3" x="510" y="330" width="110" height="24" maximumLength="4"/>
  <TextField name="eventTimes3" x="626" y="330" width="80" height="24" maximumLength="4"/>
  <Button name="eventRemove3" x="744" y="330" width="22" height="24" style="remove" text="x"/>
  <TextField name="eventAt4" x="266" y="360" width="80" height="24" maximumLength="7"/>
  <TextField name="eventWeek4" x="350" y="360" width="40" height="24" maximumLength="1"/>
  <Button name="eventDisaster4" x="394" y="360" width="110" height="24" style="pick"/>
  <TextField name="eventEvery4" x="510" y="360" width="110" height="24" maximumLength="4"/>
  <TextField name="eventTimes4" x="626" y="360" width="80" height="24" maximumLength="4"/>
  <Button name="eventRemove4" x="744" y="360" width="22" height="24" style="remove" text="x"/>

  <Text name="note" x="14" y="398" width="752" height="10" style="note"/>
  <Text name="problem" x="14" y="398" width="752" height="10" style="problem"/>
  <Button name="cancel" x="562" y="430" width="96" height="28" text="Cancel"/>
  <Button name="apply" x="666" y="430" width="100" height="28" text="Apply"/>
</UIScript>
