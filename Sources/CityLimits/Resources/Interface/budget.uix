<?xml version="1.0" encoding="UTF-8"?>
<!-- The budget, a modal window that pauses the city while it's open. It opens by itself when a
     year needs attention, with the reason under the funds. Taxes move a percent a press, and
     funding a tenth. Each figure has a warning twin in red, and the game shows one or the other. -->
<UIScript version="1">
  <Window width="460" height="380"/>

  <Style name="dim" textColor="#969EAA" fontSize="14"/>
  <Style name="figure" textColor="#E4E8EE" fontSize="14"/>
  <Style name="warning" textColor="#E86A60" fontSize="14"/>
  <Style name="funds" textColor="#E4E8EE" fontSize="20"/>
  <Style name="debt" textColor="#E86A60" fontSize="20"/>
  <Style name="step" textColor="#F0BE5A" backgroundColor="#48505C" borderColor="#48505C" fontSize="14"/>

  <Text name="fundsLabel" x="16" y="14" width="100" height="14" style="dim" text="Funds"/>
  <Text name="funds" x="200" y="10" width="244" height="20" style="funds" alignment="right"/>
  <Text name="fundsWarning" x="200" y="10" width="244" height="20" style="debt" alignment="right"/>
  <Text name="reason" x="16" y="38" width="428" height="14" style="warning"/>

  <Text name="thisYear" x="16" y="62" width="428" height="14" style="dim" text="This year, as it stands"/>
  <Button name="taxDown" x="16" y="84" width="22" height="22" style="step" text="-"/>
  <Button name="taxUp" x="42" y="84" width="22" height="22" style="step" text="+"/>
  <Text name="tax" x="74" y="88" width="170" height="14" style="figure"/>
  <Text name="taxDetail" x="250" y="88" width="194" height="14" style="dim"/>
  <Button name="roadsDown" x="16" y="114" width="22" height="22" style="step" text="-"/>
  <Button name="roadsUp" x="42" y="114" width="22" height="22" style="step" text="+"/>
  <Text name="roads" x="74" y="118" width="170" height="14" style="figure"/>
  <Text name="roadsDetail" x="250" y="118" width="194" height="14" style="dim"/>
  <Button name="fireDown" x="16" y="144" width="22" height="22" style="step" text="-"/>
  <Button name="fireUp" x="42" y="144" width="22" height="22" style="step" text="+"/>
  <Text name="fire" x="74" y="148" width="170" height="14" style="figure"/>
  <Text name="fireDetail" x="250" y="148" width="194" height="14" style="dim"/>
  <Button name="policeDown" x="16" y="174" width="22" height="22" style="step" text="-"/>
  <Button name="policeUp" x="42" y="174" width="22" height="22" style="step" text="+"/>
  <Text name="police" x="74" y="178" width="170" height="14" style="figure"/>
  <Text name="policeDetail" x="250" y="178" width="194" height="14" style="dim"/>

  <Text name="ordinances" x="16" y="208" width="428" height="14" style="figure"/>
  <Text name="deals" x="16" y="228" width="428" height="14" style="figure"/>
  <Text name="cashFlow" x="16" y="248" width="428" height="14" style="figure"/>
  <Text name="cashFlowWarning" x="16" y="248" width="428" height="14" style="warning"/>

  <Text name="lastYearLabel" x="16" y="276" width="428" height="14" style="dim" text="Last year"/>
  <Text name="lastYear" x="16" y="296" width="428" height="14" style="figure"/>
  <Text name="lastYearWarning" x="16" y="296" width="428" height="14" style="warning"/>

  <Button name="continue" x="334" y="338" width="110" height="28" style="step" text="Continue"/>
</UIScript>
