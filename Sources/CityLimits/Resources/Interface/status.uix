<?xml version="1.0" encoding="UTF-8"?>
<!-- The bar along the screen's bottom, after Tony Bark's mock-up in docs/design, with the news
     ticker under it. It stretches to the screen's width. The game draws the pause button, the
     speed arrows, the demand meter, the help button, and the ticker into their regions, and
     answers clicks on them. -->
<UIScript version="1">
  <Window width="1024" height="54" minWidth="760" minHeight="54"/>

  <Style name="bar" textColor="#E4E8EE" fontSize="14"/>
  <Style name="dim" textColor="#969EAA" fontSize="14"/>
  <Style name="name" textColor="#E4E8EE" highlightedTextColor="#F0BE5A" backgroundColor="#00000000" borderColor="#00000000" fontSize="14"/>
  <Style name="funds" textColor="#F0BE5A" highlightedTextColor="#FFFFFF" backgroundColor="#00000000" borderColor="#00000000" fontSize="14"/>
  <Style name="debt" textColor="#E86A60" highlightedTextColor="#FFFFFF" backgroundColor="#00000000" borderColor="#00000000" fontSize="14"/>

  <Region name="pausePlay" x="10" y="4" width="22" height="22"/>
  <Text name="date" x="42" y="8" width="70" height="14" style="bar"/>
  <Region name="speeds" x="112" y="4" width="48" height="22"/>
  <Button name="cityName" x="170" y="2" width="200" height="26" style="name"/>
  <Region name="demand" x="378" y="4" width="28" height="22"/>
  <Button name="funds" x="414" y="2" width="130" height="26" style="funds"/>
  <Button name="debt" x="414" y="2" width="130" height="26" style="debt"/>
  <Text name="population" x="554" y="8" width="140" height="14" style="bar"/>
  <Text name="rate" x="0" y="8" width="160" height="14" style="dim" alignment="right" edgeOffsetRight="38"/>
  <Region name="help" x="0" y="6" width="18" height="18" edgeOffsetRight="10"/>
  <Region name="ticker" x="0" y="30" width="1024" height="24" edgeOffsetLeft="0" edgeOffsetRight="0"/>
</UIScript>
